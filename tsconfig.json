{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "dist/types",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["./src/*"],
      "@sb/*": ["./.storybook/*"],
    },
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": ["src", ".storybook"],
  "exclude": ["node_modules", "dist"],
}
